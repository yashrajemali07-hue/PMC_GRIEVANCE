# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# Replace with your MongoDB connection string (e.g. mongodb+srv://<user>:<password>@cluster0.mongodb.net/pmc_db)
MONGO_URI=mongodb://localhost:27017/pmc_grievance_portal

# JWT Authentication
JWT_SECRET=pmc_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# PMC Administrator Credentials (for Admin Login)
ADMIN_USER=admin
ADMIN_PASS=adminPMC@2026

# Email / SMTP Configuration (Nodemailer for OTP verification)
# If MAIL_USERNAME is not set, OTP will be printed directly in the console (dev mode).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=PMC Grievance Portal <noreply@punecorporation.org>
