# ==========================================
# PMC Citizen Grievance Portal - Environment Configuration
# ==========================================

# Server Port (Default 5050 to prevent collision with macOS AirPlay on port 5000)
PORT=5050
NODE_ENV=development

# MongoDB Connection String:
# - For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/pmc_db?retryWrites=true&w=majority
# - For Local MongoDB: mongodb://localhost:27017/pmc_grievance_portal
# - If local MongoDB is not installed, the server automatically starts an embedded in-memory MongoDB!
MONGO_URI=mongodb://localhost:27017/pmc_grievance_portal

# JWT Authentication
JWT_SECRET=pmc_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# PMC Administrator Credentials (for Officer / Admin Login)
ADMIN_USER=admin
ADMIN_PASS=adminPMC@2026
ADMIN_EMAIL=admin@punecorporation.org

# Email / SMTP Configuration (Nodemailer for OTP verification)
# - Leave MAIL_USERNAME empty to use local Dev Mode: OTP will be printed in server console AND auto-filled in the portal UI.
# - To send real emails, set your Gmail / SMTP credentials below:
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=PMC Grievance Portal <noreply@punecorporation.org>
