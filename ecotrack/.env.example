SECRET_KEY=change-this-to-a-long-random-secret
FLASK_DEBUG=false
PORT=5000

# Local MongoDB or MongoDB Atlas connection string.
MONGO_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=ecotrack_db
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=5000
# Optional: set this to a PEM bundle path if Atlas TLS validation fails.
MONGODB_TLS_CA_FILE=

# Admin panel login.
ADMIN_USER=admin
ADMIN_PASS=change-this-admin-password

# Gmail SMTP. Use a Gmail App Password, not your normal Gmail password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=yourgmail@gmail.com
MAIL_PASSWORD=your_16_character_app_password
